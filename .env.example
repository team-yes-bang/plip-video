# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
DB_USERNAME=root
DB_PASSWORD=changeme

# 앱/DB 포트 (호스트에 노출)
SERVER_PORT=8085
MYSQL_PORT=3308

# MySQL 스키마명
MYSQL_DATABASE=plip_video

# AWS (로컬: AWS_ENABLED=true 시 실 S3/SQS/Lambda — ~/.aws/credentials 또는 env 키 필요)
AWS_ENABLED=true
AWS_REGION=ap-northeast-2
AWS_S3_RAW_BUCKET=
AWS_S3_PROCESSED_BUCKET=
AWS_SQS_VIDEO_PROCESSING_QUEUE_URL=
AWS_LAMBDA_THUMBNAIL_ARN=
AWS_CDN_BASE_URL=
AWS_PRESIGNED_URL_TTL_SECONDS=10800

# Internal callback (PR-4 InternalVideoController)
INTERNAL_API_KEY=local-dev-internal-key

# Gateway HMAC (prod/K8s: gateway + video 동일 secret). 로컬 direct 호출 시 비워두면 검증 비활성
# GATEWAY_HMAC_SECRET=local-dev-gateway-hmac-secret
# K8s: SSM /plip/gateway-hmac-secret → docs/api/video-ops-checklist.md

# destination Kafka outbox relay (complete outbox와 동일 relay 설정 공유)
# APP_KAFKA_ENABLED=true 시 relay가 video.uploaded / diary.video.uploaded produce

# topic 재생 권한 확인. HEAD /internal/v1/videos/{videoUuid}/access/{userUuid}
TOPIC_INTERNAL_BASE_URL=http://localhost:8084
TOPIC_INTERNAL_API_KEY=local-dev-internal-key

# Kafka (destination publish). IDE bootRun: localhost:29092 (plip-diary compose dual listener)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# E2E destination→diary/topic: diary(:8081) topic(:8084) consumer 기동 + diary compose kafka up
APP_KAFKA_ENABLED=true
APP_KAFKA_TOPICS_VIDEO_UPLOADED=video.uploaded
APP_KAFKA_TOPICS_DIARY_VIDEO_UPLOADED=diary.video.uploaded

# dev Terraform output 참고값 (K3s/Develop PC)
# AWS_S3_RAW_BUCKET=yes-plip-dev-media-334687118442-raw
# AWS_S3_PROCESSED_BUCKET=yes-plip-dev-media-334687118442-processed
# AWS_SQS_VIDEO_PROCESSING_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/334687118442/yes-plip-dev-video-processing
# AWS_LAMBDA_THUMBNAIL_ARN=arn:aws:lambda:ap-northeast-2:334687118442:function:yes-plip-dev-video-thumbnail
# AWS_CDN_BASE_URL=https://ds2468g03st3p.cloudfront.net
# INTERNAL_API_KEY=<SSM /yes-plip/media/lambda-internal-api-key>